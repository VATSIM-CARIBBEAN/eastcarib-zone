# Drupal 11

# Ignore vendor directory (installed by Composer)
#/vendor/

# Ignore generated/compiled files but keep uploaded media for local dev sync
web/sites/*/files/php/
web/sites/*/files/styles/
web/sites/*/files/css/
web/sites/*/files/js/
web/sites/*/files/xmlsitemap/
web/sites/*/private

# Ignore multi-site test environment
sites/simpletest

# Ignore local settings (contains DB credentials)
sites/*/*settings*.php
!sites/*/default.settings.php
sites/*/*services*.yml
!sites/*/default.services.yml
web/sites/default/settings.prod.php
# Ignore Drush site aliases
drush/sites/

# -----------------------------------------------
# DDEV local environment
# -----------------------------------------------
# Ignore everything in .ddev/ except config.yaml — DDEV regenerates everything
# else on `ddev start`. The generated .ddev/.gitignore is also excluded here so
# DDEV can manage it freely without git noise.
.ddev/*
!.ddev/config.yaml

# -----------------------------------------------
# OS / editor artifacts
# -----------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Windows Zone Identifier files (created when downloading on Windows)
*:Zone.Identifier

# -----------------------------------------------
# Composer
# -----------------------------------------------
.composer/

# -----------------------------------------------
# SQL dumps
# -----------------------------------------------   
*.sql
*.sql.gz

# -----------------------------------------------
# Local-only deployment notes (kept out of the public repo)
# -----------------------------------------------
/docs/DEPLOYMENT.md